{
  "name": "badminton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun test && bun run build && bun run test:integration",
    "test:stage1": "node --env-file=.env.local tests/stage1-integration.mjs",
    "test:stage2": "node --env-file=.env.local tests/stage1-integration.mjs",
    "test:integration": "node --env-file=.env.local tests/stage1-integration.mjs",
    "seed": "node --env-file=.env.local --experimental-strip-types src/lib/seed-mongo.ts",
    "migrate:stage1": "node --env-file=.env.local --experimental-strip-types src/lib/migrate-stage1.ts"
  },
  "dependencies": {
    "@heroui/react": "^2.8.10",
    "@internationalized/date": "^3.12.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.42.0",
    "mongodb": "^7.6.0",
    "next": "16.3.4",
    "nodemailer": "^10.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
